# Copy to fastlane/.env (git-ignored) or set as CI secrets. Never commit real values.

# App
APP_IDENTIFIER=com.example.app
APP_PROJECT_DIR=app            # or products/<slug>/04-build/app
SCHEME=App

# Apple accounts
APPLE_ID=you@example.com
TEAM_ID=XXXXXXXXXX
ITC_TEAM_ID=123456789
DEVELOPMENT_TEAM=XXXXXXXXXX

# App Store Connect API key (preferred over password auth)
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_CONTENT=base64-encoded-p8-contents

# match (code signing)
MATCH_GIT_URL=git@github.com:your-org/certificates.git
MATCH_PASSWORD=change-me
MATCH_GIT_BASIC_AUTHORIZATION=base64(user:token)   # CI only

# CI keychain
KEYCHAIN_PASSWORD=change-me
